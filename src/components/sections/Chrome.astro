---
import { useT } from '../../i18n';
const t = useT(Astro.currentLocale);
---
<a class="skip" href="#main"><Fragment set:html={t('skip')} /></a>
<div class="progress" id="progress" aria-hidden="true"></div>

<!-- intro splash (once per session, skipped for reduced motion) -->
<div class="splash" id="splash" aria-hidden="true">
  <div class="splash-in">
    <div class="splash-logo"><span>A</span><span>S</span></div>
    <div class="splash-name"><span class="ltr">Abdul-Samad Hassan</span><span class="ar-text">عبد الصمد حسن</span></div>
    <div class="splash-bar"><i></i></div>
  </div>
</div>
